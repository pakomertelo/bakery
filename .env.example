# PUBLIC: every VITE_* value is embedded in the browser bundle. Never put secrets here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe publishable key only (sb_publishable_...). Never use sb_secret_... here.
VITE_SUPABASE_ANON_KEY=sb_publishable_replace-with-the-local-key-from-supabase-status
VITE_SITE_URL=http://localhost:5173

# PRIVATE SERVER VARIABLES (reserved for later Edge Functions; never expose as VITE_*).
# Configure these with `supabase secrets set` when the corresponding phase is implemented.
# Backend/local secret only (current local CLI may report sb_secret_... or a legacy service_role key).
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=
ORDER_FROM_EMAIL=
TURNSTILE_SECRET_KEY=

# LOCAL ADMIN SCRIPT ONLY (values belong in ignored .env.local).
# SUPABASE_URL may be used instead of VITE_SUPABASE_URL by the script.
SUPABASE_URL=
LOCAL_ADMIN_EMAIL=
LOCAL_ADMIN_PASSWORD=
